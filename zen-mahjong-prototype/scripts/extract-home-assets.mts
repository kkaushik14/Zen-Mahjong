import { execFileSync } from 'node:child_process';
import { existsSync, mkdirSync, readFileSync, writeFileSync } from 'node:fs';
import { basename, resolve } from 'node:path';

interface ExportFill {
  imageHash?: string;
  imageTransform?: readonly [readonly [number, number, number], readonly [number, number, number]];
  type?: string;
}

interface ExportNode {
  fills?: readonly ExportFill[];
  id?: string;
  [key: string]: unknown;
}

const selections = [
  ['avatar', '70:18522', 'avatar'],
  ['currency', '70:18526', 'currency'],
  ['logoUpper', '75:19002', 'logo-upper'],
  ['logoLower', '75:19003', 'logo-lower'],
  ['dailyStart', '70:18553', 'daily-start'],
  ['dailyMiddle', '70:18554', 'daily-middle'],
  ['dailyEnd', '70:18555', 'daily-end'],
  ['streakStart', '70:18564', 'streak-start'],
  ['streakMiddle', '70:18565', 'streak-middle'],
  ['streakEnd', '70:18566', 'streak-end'],
  ['journeyIcon', '75:19014', 'journey-icon'],
  ['achievementIcon', '75:19025', 'achievement-icon'],
  ['settings', '70:18524', 'settings'],
] as const;

const repositoryRoot = resolve(import.meta.dirname, '..');
const baselineRoot = resolve(repositoryRoot, 'docs/v0.3.0/design-baseline/2026-10-07/export');
const review = JSON.parse(readFileSync(resolve(baselineRoot, 'design-review.json'), 'utf8')) as {
  components: readonly ExportNode[];
};
const outputRoot = resolve(repositoryRoot, 'apps/mobile/assets/artwork/home/v3');
const registryPath = resolve(
  repositoryRoot,
  'apps/mobile/src/features/home/home-assets.generated.ts',
);

function findNode(value: unknown, id: string): ExportNode | undefined {
  if (!value || typeof value !== 'object') return undefined;
  const node = value as ExportNode;
  if (node.id === id) return node;
  for (const child of Object.values(node)) {
    const found = findNode(child, id);
    if (found) return found;
  }
  return undefined;
}

function dimensions(path: string): { height: number; width: number } {
  const output = execFileSync('/usr/bin/sips', ['-g', 'pixelWidth', '-g', 'pixelHeight', path], {
    encoding: 'utf8',
  });
  const width = Number(/pixelWidth: (\d+)/.exec(output)?.[1]);
  const height = Number(/pixelHeight: (\d+)/.exec(output)?.[1]);
  if (!width || !height) throw new Error(`Unable to read image dimensions for ${path}`);
  return { height, width };
}

mkdirSync(outputRoot, { recursive: true });
const manifest = [];

for (const [key, nodeId, filename] of selections) {
  const node = findNode(review.components, nodeId);
  const fill = node?.fills?.find((candidate) => candidate.type === 'IMAGE');
  if (!node || !fill?.imageHash || !fill.imageTransform) {
    throw new Error(`Missing source metadata for ${key} (${nodeId})`);
  }

  const sourcePath = resolve(baselineRoot, `assets/${fill.imageHash}.png`);
  if (!existsSync(sourcePath)) throw new Error(`Missing source image ${sourcePath}`);
  const sourceDimensions = dimensions(sourcePath);
  const [[scaleX, , translateX], [, scaleY, translateY]] = fill.imageTransform;
  const crop = {
    height: Math.round(scaleY * sourceDimensions.height),
    width: Math.round(scaleX * sourceDimensions.width),
    x: Math.round(translateX * sourceDimensions.width),
    y: Math.round(translateY * sourceDimensions.height),
  };
  const outputPath = resolve(outputRoot, `${filename}.png`);

  execFileSync('/usr/bin/sips', [
    '--cropToHeightWidth',
    String(crop.height),
    String(crop.width),
    '--cropOffset',
    String(crop.y),
    String(crop.x),
    sourcePath,
    '--out',
    outputPath,
  ]);

  manifest.push({
    crop,
    figmaNodeId: nodeId,
    key,
    outputPath: `apps/mobile/assets/artwork/home/v3/${basename(outputPath)}`,
    sourceDimensions,
    sourceHash: fill.imageHash,
  });
}

writeFileSync(
  resolve(outputRoot, 'manifest.json'),
  `${JSON.stringify(
    {
      contentVersion: '0.3.0',
      generatedFrom: 'docs/v0.3.0/design-baseline/2026-10-07/export/design-review.json',
      items: manifest,
      schemaVersion: 1,
    },
    null,
    2,
  )}\n`,
  'utf8',
);

const entries = selections
  .map(
    ([key, , filename]) => `  ${key}: require('../../../assets/artwork/home/v3/${filename}.png'),`,
  )
  .join('\n');
writeFileSync(
  registryPath,
  `// Generated by scripts/extract-home-assets.mts. Do not edit manually.\nimport type { ImageSourcePropType } from 'react-native';\n\nexport const homeAssets = {\n${entries}\n} as const satisfies Record<string, ImageSourcePropType>;\n`,
  'utf8',
);

console.log(`Extracted ${manifest.length} Home assets to ${outputRoot}`);
