import { execFileSync } from 'node:child_process';
import { existsSync, mkdirSync, readFileSync, writeFileSync } from 'node:fs';
import { basename, dirname, resolve } from 'node:path';

interface ExportFill {
  imageHash?: string;
  imageTransform?: readonly [readonly [number, number, number], readonly [number, number, number]];
  type?: string;
}

interface ExportNode {
  children?: readonly ExportNode[];
  fills?: readonly ExportFill[];
  id?: string;
  name?: string;
  [key: string]: unknown;
}

const selections = [
  ['button.primary', '55:16587', 'button-primary'],
  ['button.secondary', '55:16590', 'button-secondary'],
  ['action.undo', '55:16593', 'action-undo'],
  ['action.hint', '55:16598', 'action-hint'],
  ['action.shuffle', '55:16603', 'action-shuffle'],
  ['action.more', '55:16608', 'action-more'],
  ['surface.trayPocket', '65:18228', 'tray-pocket'],
  ['surface.settingsRow', '82:19161', 'settings-row-marble'],
  ['surface.tileMarble', '55:16441', 'tile-marble'],
  ['popup.surface', '65:18217', 'popup-surface'],
  ['popup.top', '65:18218', 'popup-top'],
  ['popup.bottom', '65:18219', 'popup-bottom'],
  ['popup.left', '65:18220', 'popup-left'],
  ['popup.right', '65:18221', 'popup-right'],
  ['button.wideLeft', '70:18530', 'wide-button-left'],
  ['button.wideMiddle', '70:18531', 'wide-button-middle'],
  ['button.wideRight', '70:18532', 'wide-button-right'],
  ['progress.branch', '55:16619', 'progress-branch'],
] as const;

const repositoryRoot = resolve(import.meta.dirname, '..');
const baselineRoot = resolve(repositoryRoot, 'docs/v0.3.0/design-baseline/2026-10-07/export');
const review = JSON.parse(readFileSync(resolve(baselineRoot, 'design-review.json'), 'utf8')) as {
  components: readonly ExportNode[];
};
const outputRoot = resolve(repositoryRoot, 'packages/ui/assets/moonlit/v3');
const registryPath = resolve(repositoryRoot, 'packages/ui/src/moonlit-assets.generated.ts');

function findNode(value: unknown, id: string): ExportNode | undefined {
  if (!value || typeof value !== 'object') return undefined;
  const node = value as ExportNode;
  if (node.id === id) return node;
  for (const child of Object.values(node)) {
    const found = findNode(child, id);
    if (found) return found;
  }
  return undefined;
}

function dimensions(path: string): { height: number; width: number } {
  const output = execFileSync('/usr/bin/sips', ['-g', 'pixelWidth', '-g', 'pixelHeight', path], {
    encoding: 'utf8',
  });
  const width = Number(/pixelWidth: (\d+)/.exec(output)?.[1]);
  const height = Number(/pixelHeight: (\d+)/.exec(output)?.[1]);
  if (!width || !height) throw new Error(`Unable to read image dimensions for ${path}`);
  return { height, width };
}

mkdirSync(outputRoot, { recursive: true });
const manifest = [];

for (const [assetId, nodeId, filename] of selections) {
  const node = findNode(review.components, nodeId);
  const fill = node?.fills?.find((candidate) => candidate.type === 'IMAGE');
  if (!node || !fill?.imageHash || !fill.imageTransform) {
    throw new Error(`Missing source metadata for ${assetId} (${nodeId})`);
  }

  const sourcePath = resolve(baselineRoot, `assets/${fill.imageHash}.png`);
  if (!existsSync(sourcePath)) throw new Error(`Missing source image ${sourcePath}`);
  const sourceDimensions = dimensions(sourcePath);
  const [[scaleX, , translateX], [, scaleY, translateY]] = fill.imageTransform;
  const crop = {
    height: Math.round(scaleY * sourceDimensions.height),
    width: Math.round(scaleX * sourceDimensions.width),
    x: Math.round(translateX * sourceDimensions.width),
    y: Math.round(translateY * sourceDimensions.height),
  };
  const outputPath = resolve(outputRoot, `${filename}.png`);

  execFileSync('/usr/bin/sips', [
    '--cropToHeightWidth',
    String(crop.height),
    String(crop.width),
    '--cropOffset',
    String(crop.y),
    String(crop.x),
    sourcePath,
    '--out',
    outputPath,
  ]);

  manifest.push({
    assetId,
    crop,
    figmaNodeId: nodeId,
    outputPath: `packages/ui/assets/moonlit/v3/${basename(outputPath)}`,
    sourceDimensions,
    sourceHash: fill.imageHash,
  });
}

writeFileSync(
  resolve(outputRoot, 'manifest.json'),
  `${JSON.stringify(
    {
      contentVersion: '0.3.0',
      generatedFrom: 'docs/v0.3.0/design-baseline/2026-10-07/export/design-review.json',
      items: manifest,
      schemaVersion: 1,
    },
    null,
    2,
  )}\n`,
  'utf8',
);

const entries = selections
  .map(
    ([assetId, , filename]) => `  '${assetId}': require('../assets/moonlit/v3/${filename}.png'),`,
  )
  .join('\n');
writeFileSync(
  registryPath,
  `// Generated by scripts/extract-shared-component-assets.mts. Do not edit manually.\nimport type { ImageSourcePropType } from 'react-native';\n\nexport type MoonlitAssetId = ${selections.map(([id]) => `'${id}'`).join(' | ')};\n\nexport const moonlitAssetSources: Readonly<Record<MoonlitAssetId, ImageSourcePropType>> = {\n${entries}\n};\n`,
  'utf8',
);

console.log(`Extracted ${manifest.length} shared Moonlit assets to ${dirname(outputRoot)}`);
